},{"fontes":[],"formula":"PE* = mín(máx(b ÷ (k − g); 0,6 × PE_0); 1,6 × PE_0)","id":"etf.pl_justificado","premissas":"P/L corrente PE_0 = 1 ÷ lucro por preço agregado = 9,3x","resultado":10.91,"resultado_texto":"10,91x","substituicao":"PE* = mín(máx(79,78% ÷ (11,71% − 4,40%); 0,6 × 9,3x); 1,6 × 9,3x) = 10,91x","titulo":"P/L justificado do índice (limitado em relação ao corrente)","unidade":"x"},{"fontes":[],"formula":"R = (PE_12 ÷ PE_0) × (1 + g_LPA) × (1 + φ) − 1 + DY × (1 + φ); PE_12 = PE_0 × (PE* ÷ PE_0)^(1 − 2^(−1/3))","id":"etf.td1","premissas":null,"resultado":0.170821,"resultado_texto":"17,08%","substituicao":"R = (9,62x ÷ 9,31x) × (1 + 9,21%) × (1 + (−0,85%)) − 1 + 5,24% × (1 + (−0,85%)) = 17,08%","titulo":"Top-down 1: P/L justificado com reversão parcial","unidade":"%"},{"fontes":[],"formula":"E[R] = (1 + D/P − ΔS + i + g + ΔPE) × (1 + φ) − 1, com ΔPE = ln(PE_12 ÷ PE_0)","id":"etf.td2","premissas":null,"resultado":0.0906552,"resultado_texto":"9,07%","substituicao":"E[R] = (1 + 5,24% − 3,75% + 3,23% + 2,00% + 3,28%) × (1 + (−0,85%)) − 1 = 9,07%","titulo":"Top-down 2: Grinold–Kroner","unidade":"%"},{"fontes":[],"formula":"R_TD = média(TD1, TD2 disponíveis)","id":"etf.td","premissas":null,"resultado":0.130738,"resultado_texto":"13,07%","substituicao":"R_TD = média(17,08%; 9,07%) = 13,07%","titulo":"Top-down combinado","unidade":"%"},{"fontes":[],"formula":"R_BU = Σ w_i × [(1 + u_i)(1 + φ_i) − 1 + y_i(1 + φ_i)] + c × r_caixa − TER","id":"etf.bu","premissas":"peso coberto por alvos citáveis da casa (confiança A ou B, sem aviso de retorno extremo ou patrimônio frágil) 86,12%; as demais posições recebem o retorno top-down","resultado":0.117441,"resultado_texto":"11,74%","substituicao":"R_BU = Σ das 46 posições + 1,69% × 4,02% − 0,59% = 11,74%","titulo":"Bottom-up (alvos da casa por posição)","unidade":"%"},{"fontes":[],"formula":"R_e = ω × R_BU + (1 − ω) × R_TD; ω = 0,5 × mín(1; cobertura ÷ 0,90)","id":"etf.combinado","premissas":null,"resultado":0.124376,"resulta