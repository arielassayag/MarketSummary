_0)","id":"etf.pl_justificado","premissas":"P/L corrente PE_0 = 1 ÷ lucro por preço agregado = 9,4x","resultado":10.9802,"resultado_texto":"10,98x","substituicao":"PE* = mín(máx(79,86% ÷ (11,67% − 4,40%); 0,6 × 9,4x); 1,6 × 9,4x) = 10,98x","titulo":"P/L justificado do índice (limitado em relação ao corrente)","unidade":"x"},{"fontes":[],"formula":"R = (PE_12 ÷ PE_0) × (1 + g_LPA) × (1 + φ) − 1 + DY × (1 + φ); PE_12 = PE_0 × (PE* ÷ PE_0)^(1 − 2^(−1/3))","id":"etf.td1","premissas":null,"resultado":0.167643,"resultado_texto":"16,76%","substituicao":"R = (9,70x ÷ 9,39x) × (1 + 9,04%) × (1 + (−0,85%)) − 1 + 5,16% × (1 + (−0,85%)) = 16,76%","titulo":"Top-down 1: P/L justificado com reversão parcial","unidade":"%"},{"fontes":[],"formula":"E[R] = (1 + D/P − ΔS + i + g + ΔPE) × (1 + φ) − 1, com ΔPE = ln(PE_12 ÷ PE_0)","id":"etf.td2","premissas":null,"resultado":0.0900212,"resultado_texto":"9,00%","substituicao":"E[R] = (1 + 5,16% − 3,67% + 3,23% + 2,00% + 3,22%) × (1 + (−0,85%)) − 1 = 9,00%","titulo":"Top-down 2: Grinold–Kroner","unidade":"%"},{"fontes":[],"formula":"R_TD = média(TD1, TD2 disponíveis)","id":"etf.td","premissas":null,"resultado":0.128832,"resultado_texto":"12,88%","substituicao":"R_TD = média(16,76%; 9,00%) = 12,88%","titulo":"Top-down combinado","unidade":"%"},{"fontes":[],"formula":"R_BU = Σ w_i × [(1 + u_i)(1 + φ_i) − 1 + y_i(1 + φ_i)] + c × r_caixa − TER","id":"etf.bu","premissas":"peso coberto por alvos citáveis da casa (confiança A ou B, sem aviso de retorno extremo ou patrimônio frágil) 68,20%; as demais posições recebem o retorno top-down","resultado":0.0113276,"resultado_texto":"1,13%","substituicao":"R_BU = Σ das 46 posições + 1,61% × 4,08% − 0,59% = 1,13%","titulo":"Bottom-up (alvos da casa por posição)","unidade":"%"},{"fontes":[],"formula":"R_e = ω × R_BU + (1 − ω) × R_TD; ω = 0,5 × mín(1; cobertura ÷ 0,90)","id":"etf.combinado","premissas":null,"resultado":0.0843107,"resultado_texto":"8,43%","substituicao":"R_e = 0,379 × 1,13% + 0,621 × 12,88% = 8,43%","titulo":"Retorno esperado de 12 meses","unidade":"%"},{"fontes":[],"formula":"TP_e = P_e × (1 + R_e − DY_distribuído)","id":"etf.alvo","premissas":null,"resultado":44.3453,"resultado_texto":"US$ 44,35","substituicao":"TP_e = US$ 42,94 × (1 + 8,43% − 5,16%) = US$ 44,35","titulo":"Preço-alvo de 12 meses do ETF","unidade":"preco:USD"},{"fontes":[],"formula":"TP_e × exp(± 1,645 × σ)","id":"etf.banda","premissas":"σ = volatilidade realizada de 12 meses","resultado":71.0502,"resultado_texto":"US$ 27,68 a US$ 71,05","substituicao":"US$ 44,35 × exp(± 1,645 × 28,66%) = US$ 27,68 a US$ 71,05","titulo":"Faixa de 90% do preço em 12 meses","unidade":"preco:USD"},{"fontes":[],"formula":"IR = (R_e − R_ILF) ÷ TE; limiar ±0,3","id":"etf.visao","premissas":"visão neutra","resultado":0.157984,"resultado_texto":"0,1580","substituicao":"IR = (8,43% − 6,96%) ÷ 9,34% = 0,1580","titulo":"Visão relativa ao ILF","unidade":"n"},{"fontes":[],"formula":"","id":"etf.qualidade","premissas":null,"resultado":null,"resultado_texto":"E1 Preço-alvo finito e positivo: ok (preço-alvo do ETF); E2 Retorno esperado plausível: ok (retorno esperado 8,43% (faixa −50% a 100%)); E3 P/L justificado coerente com o corrente: ok (P/L justificado ÷ P/L corrente = 1,17 (faixa 0,6 a 1,6; fora dela, limitado)); E4 Top-down com componentes plausíveis: ok (payout sustentável, crescimento e retorno do índice dentro dos limites); E5 Bottom-up sem concentração em uma posição: ok (maior contribuição de uma posição além do top-down: BR_NU com 4,4% (limite 5%)).","substituicao":"E1 Preço-alvo finito e positivo: ok (preço-alvo do ETF); E2 Retorno esperado plausível: ok (retorno esperado 8,43% (faixa −50% a 100%)); E3 P/L justificado coerente com o corrente: ok (P/L justificado ÷ P/L corrente = 1,17 (faixa 0,6 a 1,6; fora dela, limitado)); E4 Top-down com componentes plausíveis: ok (payout sustentável, crescimento e retorno do índice dentro dos limites); E5 Bottom-up sem concentração em uma posição: ok (maior contribuiç