f.pl_justificado","premissas":"P/L corrente PE_0 = 1 ÷ lucro por preço agregado = 9,8x","resultado":9.96178,"resultado_texto":"9,96x","substituicao":"PE* = mín(máx(79,82% ÷ (12,41% − 4,40%); 0,6 × 9,8x); 1,6 × 9,8x) = 9,96x","titulo":"P/L justificado do índice (limitado em relação ao corrente)","unidade":"x"},{"fontes":[],"formula":"R = (PE_12 ÷ PE_0) × (1 + g_LPA) × (1 + φ) − 1 + DY × (1 + φ); PE_12 = PE_0 × (PE* ÷ PE_0)^(1 − 2^(−1/3))","id":"etf.td1","premissas":null,"resultado":0.125669,"resultado_texto":"12,57%","substituicao":"R = (9,85x ÷ 9,83x) × (1 + 7,30%) × (1 + 0,00%) − 1 + 4,97% × (1 + 0,00%) = 12,57%","titulo":"Top-down 1: P/L justificado com reversão parcial","unidade":"%"},{"fontes":[],"formula":"E[R] = (1 + D/P − ΔS + i + g + ΔPE) × (1 + φ) − 1, com ΔPE = ln(PE_12 ÷ PE_0)","id":"etf.td2","premissas":null,"resultado":0.0767288,"resultado_texto":"7,67%","substituicao":"E[R] = (1 + 4,97% − 1,93% + 2,35% + 2,00% + 0,28%) × (1 + 0,00%) − 1 = 7,67%","titulo":"Top-down 2: Grinold–Kroner","unidade":"%"},{"fontes":[],"formula":"R_TD = média(TD1, TD2 disponíveis)","id":"etf.td","premissas":null,"resultado":0.101199,"resultado_texto":"10,12%","substituicao":"R_TD = média(12,57%; 7,67%) = 10,12%","titulo":"Top-down combinado","unidade":"%"},{"fontes":[],"formula":"R_BU = Σ w_i × [(1 + u_i)(1 + φ_i) − 1 + y_i(1 + φ_i)] + c × r_caixa − TER","id":"etf.bu","premissas":"peso coberto por alvos citáveis da casa (confiança A ou B, sem aviso de retorno extremo ou patrimônio frágil) 64,13%; as demais posições recebem o retorno top-down","resultado":0.0212621,"resultado_texto":"2,13%","substituicao":"R_BU = Σ das 41 posições + 0,93% × 4,08% − 0,47% = 2,13%","titulo":"Bottom-up (alvos da casa por posição)","unidade":"%"},{"fontes":[],"formula":"R_e = ω × R_BU + (1 − ω) × R_TD; ω = 0,5 × mín(1; cobertura ÷ 0,90)","id":"etf.combinado","premissas":null,"resultado":0.0727178,"resultado_texto":"7,27%","substituicao":"R_e = 0,356 × 2,13% + 0,644 × 10,12% = 7,27%","titulo":"Retorn