orno esperado de 12 meses","unidade":"%"},{"fontes":[],"formula":"TP_e = P_e × (1 + R_e − DY_distribuído)","id":"etf.alvo","premissas":null,"resultado":181.903,"resultado_texto":"R$ 181,90","substituicao":"TP_e = R$ 164,82 × (1 + 16,66% − 6,29%) = R$ 181,90","titulo":"Preço-alvo de 12 meses do ETF","unidade":"preco:BRL"},{"fontes":[],"formula":"TP_e × exp(± 1,645 × σ)","id":"etf.banda","premissas":"σ = volatilidade realizada de 12 meses","resultado":277.778,"resultado_texto":"R$ 119,12 a R$ 277,78","substituicao":"R$ 181,90 × exp(± 1,645 × 25,74%) = R$ 119,12 a R$ 277,78","titulo":"Faixa de 90% do preço em 12 meses","unidade":"preco:BRL"},{"fontes":[],"formula":"IR = (R_e − R_ILF) ÷ TE; limiar ±0,3","id":"etf.visao","premissas":"visão positiva","resultado":0.50366,"resultado_texto":"0,5037","substituicao":"IR = (16,66% − 10,66%) ÷ 11,90% = 0,5037","titulo":"Visão relativa ao ILF","unidade":"n"},{"fontes":[],"formula":"","id":"etf.qualidade","premissas":null,"resultado":null,"resultado_texto":"E1 Preço-alvo finito e positivo: ok (preço-alvo do ETF); E2 Retorno esperado plausível: ok (retorno esperado 16,66% (faixa −50% a 100%)); E3 P/L justificado coerente com o corrente: ok (P/L justificado ÷ P/L corrente = 1,39 (faixa 0,6 a 1,6; fora dela, limitado)); E4 Top-down com componentes plausíveis: ok (payout sustentável, crescimento e retorno do índice dentro dos limites); E5 Bottom-up sem concentração em uma posição: ok (maior contribuição de uma posição além do top-down: BR_VALE com 2,7% (limite 5%)).","substituicao":"E1 Preço-alvo finito e positivo: ok (preço-alvo do ETF); E2 Retorno esperado plausível: ok (retorno esperado 16,66% (faixa −50% a 100%)); E3 P/L justificado coerente com o corrente: ok (P/L justificado ÷ P/L corrente = 1,39 (faixa 0,6 a 1,6; fora dela, limitado)); E4 Top-down com componentes plausíveis: ok (payout sustentável, crescimento e retorno do índice dentro dos limites); E5 Bottom-up sem concentração em uma posição: ok (maior contribuição de uma po