# Ambientes virtuais e dependências
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Variáveis de ambiente e segredos
.env
*.env
.env.*
!.env.example

# Banco de dados e saídas locais
fechamento.db
fechamento.db-journal
outputs/
*.sqlite3

# Caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Sistema Operacional
.DS_Store
Thumbs.db

# Agentes locais (as skills neutras do CDP em .agents/skills/ são versionadas)
.agents/*
!.agents/skills/

# Cache de dados abertos (CVM/SEC) baixados pelo módulo de fundamentos PIT
data/cache/

# CDP: trava e staging do armazenamento de mercado
data/market/.write.lock
data/market/**/.*.staging-*

# CDP: logs das rotinas locais (scripts/cdp_run_task.*)
logs/

# CDP: área temporária do pré-início (cdp reinicio; removida ao terminar)
.cdp_reinicio.tmp/

# CDP: identidade do clone e registros das execuções (cdp executor registrar, cdp rotinas gate)
.cdp/

# CDP: portal montado localmente (cdp site construir; publicado só pelo GitHub Actions)
_site/
_site_demo/
