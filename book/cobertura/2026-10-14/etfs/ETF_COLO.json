icado","premissas":"P/L corrente PE_0 = 1 ÷ lucro por preço agregado = 10,5x","resultado":9.94041,"resultado_texto":"9,94x","substituicao":"PE* = mín(máx(69,71% ÷ (11,41% − 4,40%); 0,6 × 10,5x); 1,6 × 10,5x) = 9,94x","titulo":"P/L justificado do índice (limitado em relação ao corrente)","unidade":"x"},{"fontes":[],"formula":"R = (PE_12 ÷ PE_0) × (1 + g_LPA) × (1 + φ) − 1 + DY × (1 + φ); PE_12 = PE_0 × (PE* ÷ PE_0)^(1 − 2^(−1/3))","id":"etf.td1","premissas":null,"resultado":0.0779159,"resultado_texto":"7,79%","substituicao":"R = (10,41x ÷ 10,53x) × (1 + 6,51%) × (1 + (−1,51%)) − 1 + 4,20% × (1 + (−1,51%)) = 7,79%","titulo":"Top-down 1: P/L justificado com reversão parcial","unidade":"%"},{"fontes":[],"formula":"E[R] = (1 + D/P − ΔS + i + g + ΔPE) × (1 + φ) − 1, com ΔPE = ln(PE_12 ÷ PE_0)","id":"etf.td2","premissas":null,"resultado":0.115451,"resultado_texto":"11,55%","substituicao":"E[R] = (1 + 4,20% − (−4,33%) + 3,92% + 2,00% + (−1,19%)) × (1 + (−1,51%)) − 1 = 11,55%","titulo":"Top-down 2: Grinold–Kroner","unidade":"%"},{"fontes":[],"formula":"R_TD = média(TD1, TD2 disponíveis)","id":"etf.td","premissas":null,"resultado":0.0966834,"resultado_texto":"9,67%","substituicao":"R_TD = média(7,79%; 11,55%) = 9,67%","titulo":"Top-down combinado","unidade":"%"},{"fontes":[],"formula":"R_BU = Σ w_i × [(1 + u_i)(1 + φ_i) − 1 + y_i(1 + φ_i)] + c × r_caixa − TER","id":"etf.bu","premissas":"peso coberto por alvos citáveis da casa (confiança A ou B, sem aviso de retorno extremo ou patrimônio frágil) 45,44%; as demais posições recebem o retorno top-down","resultado":0.0524394,"resultado_texto":"5,24%","substituicao":"R_BU = Σ das 26 posições + 0,00% × 4,08% − 0,62% = 5,24%","titulo":"Bottom-up (alvos da casa por posição)","unidade":"%"},{"fontes":[],"formula":"R_e = ω × R_BU + (1 − ω) × R_TD; ω = 0,5 × mín(1; cobertura ÷ 0,90)","id":"etf.combinado","premissas":null,"resultado":0.0855134,"resultado_texto":"8,55%","substituicao":"R_e = 0,252 × 5,24% + 0,748 × 9,67% = 8,55%","titulo":