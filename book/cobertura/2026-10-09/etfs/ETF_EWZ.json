":"%"},{"fontes":[],"formula":"PE* = mín(máx(b ÷ (k − g); 0,6 × PE_0); 1,6 × PE_0)","id":"etf.pl_justificado","premissas":"P/L corrente PE_0 = 1 ÷ lucro por preço agregado = 9,6x","resultado":10.6276,"resultado_texto":"10,63x","substituicao":"PE* = mín(máx(79,31% ÷ (11,86% − 4,40%); 0,6 × 9,6x); 1,6 × 9,6x) = 10,63x","titulo":"P/L justificado do índice (limitado em relação ao corrente)","unidade":"x"},{"fontes":[],"formula":"R = (PE_12 ÷ PE_0) × (1 + g_LPA) × (1 + φ) − 1 + DY × (1 + φ); PE_12 = PE_0 × (PE* ÷ PE_0)^(1 − 2^(−1/3))","id":"etf.td1","premissas":null,"resultado":0.156664,"resultado_texto":"15,67%","substituicao":"R = (9,82x ÷ 9,62x) × (1 + 9,29%) × (1 + (−0,85%)) − 1 + 5,09% × (1 + (−0,85%)) = 15,67%","titulo":"Top-down 1: P/L justificado com reversão parcial","unidade":"%"},{"fontes":[],"formula":"E[R] = (1 + D/P − ΔS + i + g + ΔPE) × (1 + φ) − 1, com ΔPE = ln(PE_12 ÷ PE_0)","id":"etf.td2","premissas":null,"resultado":0.0771814,"resultado_texto":"7,72%","substituicao":"E[R] = (1 + 5,09% − 3,74% + 3,23% + 2,00% + 2,06%) × (1 + (−0,85%)) − 1 = 7,72%","titulo":"Top-down 2: Grinold–Kroner","unidade":"%"},{"fontes":[],"formula":"R_TD = média(TD1, TD2 disponíveis)","id":"etf.td","premissas":null,"resultado":0.116923,"resultado_texto":"11,69%","substituicao":"R_TD = média(15,67%; 7,72%) = 11,69%","titulo":"Top-down combinado","unidade":"%"},{"fontes":[],"formula":"R_BU = Σ w_i × [(1 + u_i)(1 + φ_i) − 1 + y_i(1 + φ_i)] + c × r_caixa − TER","id":"etf.bu","premissas":"peso coberto por alvos citáveis da casa (confiança A ou B, sem aviso de retorno extremo ou patrimônio frágil) 68,36%; as demais posições recebem o retorno top-down","resultado":0.010409,"resultado_texto":"1,04%","substituicao":"R_BU = Σ das 45 posições + 1,98% × 4,04% − 0,59% = 1,04%","titulo":"Bottom-up (alvos da casa por posição)","unidade":"%"},{"fontes":[],"formula":"R_e = ω × R_BU + (1 − ω) × R_TD; ω = 0,5 × mín(1; cobertura ÷ 0,90)","id":"etf.combinado","premissas":null,"resultado":0.0764715,"r