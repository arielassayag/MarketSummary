,6 × PE_0)","id":"etf.pl_justificado","premissas":"P/L corrente PE_0 = 1 ÷ lucro por preço agregado = 12,0x","resultado":12.2126,"resultado_texto":"12,21x","substituicao":"PE* = mín(máx(65,98% ÷ (9,80% − 4,40%); 0,6 × 12,0x); 1,6 × 12,0x) = 12,21x","titulo":"P/L justificado do índice (limitado em relação ao corrente)","unidade":"x"},{"fontes":[],"formula":"R = (PE_12 ÷ PE_0) × (1 + g_LPA) × (1 + φ) − 1 + DY × (1 + φ); PE_12 = PE_0 × (PE* ÷ PE_0)^(1 − 2^(−1/3))","id":"etf.td1","premissas":null,"resultado":0.114472,"resultado_texto":"11,45%","substituicao":"R = (12,06x ÷ 12,03x) × (1 + 9,07%) × (1 + (−0,66%)) − 1 + 2,77% × (1 + (−0,66%)) = 11,45%","titulo":"Top-down 1: P/L justificado com reversão parcial","unidade":"%"},{"fontes":[],"formula":"E[R] = (1 + D/P − ΔS + i + g + ΔPE) × (1 + φ) − 1, com ΔPE = ln(PE_12 ÷ PE_0)","id":"etf.td2","premissas":null,"resultado":0.0819779,"resultado_texto":"8,20%","substituicao":"E[R] = (1 + 2,77% − (−0,80%) + 3,03% + 2,00% + 0,32%) × (1 + (−0,66%)) − 1 = 8,20%","titulo":"Top-down 2: Grinold–Kroner","unidade":"%"},{"fontes":[],"formula":"R_TD = média(TD1, TD2 disponíveis)","id":"etf.td","premissas":null,"resultado":0.0982248,"resultado_texto":"9,82%","substituicao":"R_TD = média(11,45%; 8,20%) = 9,82%","titulo":"Top-down combinado","unidade":"%"},{"fontes":[],"formula":"R_BU = Σ w_i × [(1 + u_i)(1 + φ_i) − 1 + y_i(1 + φ_i)] + c × r_caixa − TER","id":"etf.bu","premissas":"peso coberto por alvos citáveis da casa (confiança A ou B, sem aviso de retorno extremo ou patrimônio frágil) 56,32%; as demais posições recebem o retorno top-down","resultado":0.0562693,"resultado_texto":"5,63%","substituicao":"R_BU = Σ das 26 posições + 0,19% × 4,04% − 0,59% = 5,63%","titulo":"Bottom-up (alvos da casa por posição)","unidade":"%"},{"fontes":[],"formula":"R_e = ω × R_BU + (1 − ω) × R_TD; ω = 0,5 × mín(1; cobertura ÷ 0,90)","id":"etf.combinado","premissas":null,"resultado":0.0850984,"resultado_texto":"8,51%","substituicao":"R_e = 0,313 × 5,63% + 0,6