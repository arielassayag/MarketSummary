ável do índice","unidade":"%"},{"fontes":[],"formula":"PE* = mín(máx(b ÷ (k − g); 0,6 × PE_0); 1,6 × PE_0)","id":"etf.pl_justificado","premissas":"P/L corrente PE_0 = 1 ÷ lucro por preço agregado = 13,4x","resultado":13.4558,"resultado_texto":"13,46x","substituicao":"PE* = mín(máx(80,24% ÷ (10,36% − 4,40%); 0,6 × 13,4x); 1,6 × 13,4x) = 13,46x","titulo":"P/L justificado do índice (limitado em relação ao corrente)","unidade":"x"},{"fontes":[],"formula":"R = (PE_12 ÷ PE_0) × (1 + g_LPA) × (1 + φ) − 1 + DY × (1 + φ); PE_12 = PE_0 × (PE* ÷ PE_0)^(1 − 2^(−1/3))","id":"etf.td1","premissas":null,"resultado":0.120545,"resultado_texto":"12,05%","substituicao":"R = (13,39x ÷ 13,37x) × (1 + 8,72%) × (1 + 0,29%) − 1 + 2,86% × (1 + 0,29%) = 12,05%","titulo":"Top-down 1: P/L justificado com reversão parcial","unidade":"%"},{"fontes":[],"formula":"E[R] = (1 + D/P − ΔS + i + g + ΔPE) × (1 + φ) − 1, com ΔPE = ln(PE_12 ÷ PE_0)","id":"etf.td2","premissas":null,"resultado":0.0595977,"resultado_texto":"5,96%","substituicao":"E[R] = (1 + 2,86% − 1,40% + 2,05% + 2,00% + 0,13%) × (1 + 0,29%) − 1 = 5,96%","titulo":"Top-down 2: Grinold–Kroner","unidade":"%"},{"fontes":[],"formula":"R_TD = média(TD1, TD2 disponíveis)","id":"etf.td","premissas":null,"resultado":0.0900712,"resultado_texto":"9,01%","substituicao":"R_TD = média(12,05%; 5,96%) = 9,01%","titulo":"Top-down combinado","unidade":"%"},{"fontes":[],"formula":"R_BU = Σ w_i × [(1 + u_i)(1 + φ_i) − 1 + y_i(1 + φ_i)] + c × r_caixa − TER","id":"etf.bu","premissas":"peso coberto por alvos citáveis da casa (confiança A ou B, sem aviso de retorno extremo ou patrimônio frágil) 40,59%; as demais posições recebem o retorno top-down","resultado":0.0395678,"resultado_texto":"3,96%","substituicao":"R_BU = Σ das 25 posições + 0,30% × 4,12% − 0,59% = 3,96%","titulo":"Bottom-up (alvos da casa por posição)","unidade":"%"},{"fontes":[],"formula":"R_e = ω × R_BU + (1 − ω) × R_TD; ω = 0,5 × mín(1; cobertura ÷ 0,90)","id":"etf.combinado","premissas":null,"res