nidade":"%"},{"fontes":[],"formula":"PE* = mín(máx(b ÷ (k − g); 0,6 × PE_0); 1,6 × PE_0)","id":"etf.pl_justificado","premissas":"P/L corrente PE_0 = 1 ÷ lucro por preço agregado = 9,4x","resultado":10.9729,"resultado_texto":"10,97x","substituicao":"PE* = mín(máx(79,81% ÷ (11,67% − 4,40%); 0,6 × 9,4x); 1,6 × 9,4x) = 10,97x","titulo":"P/L justificado do índice (limitado em relação ao corrente)","unidade":"x"},{"fontes":[],"formula":"R = (PE_12 ÷ PE_0) × (1 + g_LPA) × (1 + φ) − 1 + DY × (1 + φ); PE_12 = PE_0 × (PE* ÷ PE_0)^(1 − 2^(−1/3))","id":"etf.td1","premissas":null,"resultado":0.170141,"resultado_texto":"17,01%","substituicao":"R = (9,72x ÷ 9,42x) × (1 + 9,35%) × (1 + (−0,85%)) − 1 + 5,18% × (1 + (−0,85%)) = 17,01%","titulo":"Top-down 1: P/L justificado com reversão parcial","unidade":"%"},{"fontes":[],"formula":"E[R] = (1 + D/P − ΔS + i + g + ΔPE) × (1 + φ) − 1, com ΔPE = ln(PE_12 ÷ PE_0)","id":"etf.td2","premissas":null,"resultado":0.0894908,"resultado_texto":"8,95%","substituicao":"E[R] = (1 + 5,18% − 3,67% + 3,23% + 2,00% + 3,15%) × (1 + (−0,85%)) − 1 = 8,95%","titulo":"Top-down 2: Grinold–Kroner","unidade":"%"},{"fontes":[],"formula":"R_TD = média(TD1, TD2 disponíveis)","id":"etf.td","premissas":null,"resultado":0.129816,"resultado_texto":"12,98%","substituicao":"R_TD = média(17,01%; 8,95%) = 12,98%","titulo":"Top-down combinado","unidade":"%"},{"fontes":[],"formula":"R_BU = Σ w_i × [(1 + u_i)(1 + φ_i) − 1 + y_i(1 + φ_i)] + c × r_caixa − TER","id":"etf.bu","premissas":"peso coberto por alvos citáveis da casa (confiança A ou B, sem aviso de retorno extremo ou patrimônio frágil) 85,41%; as demais posições recebem o retorno top-down","resultado":0.119156,"resultado_texto":"11,92%","substituicao":"R_BU = Σ das 46 posições + 1,60% × 4,06% − 0,59% = 11,92%","titulo":"Bottom-up (alvos da casa por posição)","unidade":"%"},{"fontes":[],"formula":"R_e = ω × R_BU + (1 − ω) × R_TD; ω = 0,5 × mín(1; cobertura ÷ 0,90)","id":"etf.combinado","premissas":null,"resultado":0.12