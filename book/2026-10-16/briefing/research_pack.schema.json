{
  "$defs": {
    "Catalyst": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "direction": {
          "default": "uncertain",
          "enum": [
            "positive",
            "negative",
            "uncertain"
          ],
          "title": "Direction",
          "type": "string"
        },
        "expected_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Date"
        }
      },
      "required": [
        "description"
      ],
      "title": "Catalyst",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "fact",
        "news",
        "source"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "ref_id": {
          "description": "fact_id, news_id ou URL",
          "title": "Ref Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "MacroNoteInput": {
      "additionalProperties": false,
      "description": "Nota macro por país/tema escrita pela mente (escopo 'GOVERNANÇA' é reservado).",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "is_synthetic": {
          "default": false,
          "title": "Is Synthetic",
          "type": "boolean"
        },
        "key_events": {
          "items": {
            "$ref": "#/$defs/Catalyst"
          },
          "title": "Key Events",
          "type": "array"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "note_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Note Id",
          "type": "string"
        },
        "portfolio_implications": {
          "items": {
            "type": "string"
          },
          "title": "Portfolio Implications",
          "type": "array"
        },
        "prompt_version": {
          "default": "importado",
          "title": "Prompt Version",
          "type": "string"
        },
        "provider": {
          "default": "",
          "maxLength": 100,
          "title": "Provider",
          "type": "string"
        },
        "regime": {
          "title": "Regime",
          "type": "string"
        },
        "risks": {
          "items": {
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        },
        "scope": {
          "description": "BR, MX, …, GLOBAL ou tema.",
          "maxLength": 50,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "stance": {
          "maximum": 2,
          "minimum": -2,
          "title": "Stance",
          "type": "integer"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "week": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Week"
        }
      },
      "required": [
        "note_id",
        "scope",
        "stance",
        "regime",
        "summary",
        "created_at"
      ],
      "title": "MacroNoteInput",
      "type": "object"
    },
    "ResearchNoteInput": {
      "additionalProperties": false,
      "description": "Nota de pesquisa por emissor escrita pela mente (validada por providers/imported.py).",
      "properties": {
        "bear_points": {
          "items": {
            "type": "string"
          },
          "title": "Bear Points",
          "type": "array"
        },
        "bull_points": {
          "items": {
            "type": "string"
          },
          "title": "Bull Points",
          "type": "array"
        },
        "catalysts": {
          "items": {
            "$ref": "#/$defs/Catalyst"
          },
          "title": "Catalysts",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "description": "Com fuso horário; data não posterior à data da análise (use o horário real da escrita no mesmo dia; nunca um carimbo retroativo).",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "horizon_weeks": {
          "default": 8,
          "maximum": 52,
          "minimum": 1,
          "title": "Horizon Weeks",
          "type": "integer"
        },
        "is_synthetic": {
          "default": false,
          "title": "Is Synthetic",
          "type": "boolean"
        },
        "issuer_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Issuer Id",
          "type": "string"
        },
        "key_risks": {
          "items": {
            "type": "string"
          },
          "title": "Key Risks",
          "type": "array"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "note_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Note Id",
          "type": "string"
        },
        "prompt_version": {
          "default": "importado",
          "title": "Prompt Version",
          "type": "string"
        },
        "provider": {
          "default": "",
          "description": "Mente/analista (ex.: claude-code).",
          "maxLength": 100,
          "title": "Provider",
          "type": "string"
        },
        "role": {
          "enum": [
            "fundamental",
            "news_sentiment",
            "short_risk",
            "bull_bear_judge"
          ],
          "title": "Role",
          "type": "string"
        },
        "squeeze": {
          "anyOf": [
            {
              "$ref": "#/$defs/SqueezeAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stance": {
          "maximum": 2,
          "minimum": -2,
          "title": "Stance",
          "type": "integer"
        },
        "thesis": {
          "minLength": 1,
          "title": "Thesis",
          "type": "string"
        },
        "week": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Se informado, igual à semana.",
          "title": "Week"
        }
      },
      "required": [
        "note_id",
        "issuer_id",
        "role",
        "stance",
        "confidence",
        "thesis",
        "created_at"
      ],
      "title": "ResearchNoteInput",
      "type": "object"
    },
    "ResearchViewInput": {
      "additionalProperties": false,
      "description": "Restrição pura de risco (score 0): no_short/no_long/max_abs_weight — a IA só aperta.",
      "properties": {
        "author": {
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "issuer_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Issuer Id",
          "type": "string"
        },
        "max_abs_weight": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Abs Weight"
        },
        "no_long": {
          "default": false,
          "title": "No Long",
          "type": "boolean"
        },
        "no_short": {
          "default": false,
          "title": "No Short",
          "type": "boolean"
        },
        "note_ids": {
          "items": {
            "type": "string"
          },
          "title": "Note Ids",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "score": {
          "const": 0,
          "default": 0,
          "title": "Score",
          "type": "integer"
        },
        "source": {
          "const": "ai",
          "default": "ai",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "issuer_id",
        "confidence",
        "rationale",
        "author"
      ],
      "title": "ResearchViewInput",
      "type": "object"
    },
    "SqueezeAssessment": {
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "ok",
            "caution",
            "veto"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "rationale"
      ],
      "title": "SqueezeAssessment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Pacote de pesquisa da semana escrito pela mente (book/<semana>/inputs/research_pack.json).",
  "properties": {
    "macro": {
      "items": {
        "$ref": "#/$defs/MacroNoteInput"
      },
      "title": "Macro",
      "type": "array"
    },
    "mind": {
      "enum": [
        "claude-code",
        "codex",
        "api",
        "demo",
        "chatgpt",
        "gemini",
        "outro"
      ],
      "title": "Mind",
      "type": "string"
    },
    "notes": {
      "items": {
        "$ref": "#/$defs/ResearchNoteInput"
      },
      "title": "Notes",
      "type": "array"
    },
    "views": {
      "items": {
        "$ref": "#/$defs/ResearchViewInput"
      },
      "title": "Views",
      "type": "array"
    }
  },
  "required": [
    "mind"
  ],
  "title": "ResearchPackFile",
  "type": "object"
}
