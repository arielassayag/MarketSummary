":"etf.pl_justificado","premissas":"P/L corrente PE_0 = 1 ÷ lucro por preço agregado = 9,6x","resultado":10.5196,"resultado_texto":"10,52x","substituicao":"PE* = mín(máx(76,51% ÷ (11,67% − 4,40%); 0,6 × 9,6x); 1,6 × 9,6x) = 10,52x","titulo":"P/L justificado do índice (limitado em relação ao corrente)","unidade":"x"},{"fontes":[],"formula":"R = (PE_12 ÷ PE_0) × (1 + g_LPA) × (1 + φ) − 1 + DY × (1 + φ); PE_12 = PE_0 × (PE* ÷ PE_0)^(1 − 2^(−1/3))","id":"etf.td1","premissas":null,"resultado":0.168184,"resultado_texto":"16,82%","substituicao":"R = (9,76x ÷ 9,58x) × (1 + 9,58%) × (1 + 0,00%) − 1 + 5,10% × (1 + 0,00%) = 16,82%","titulo":"Top-down 1: P/L justificado com reversão parcial","unidade":"%"},{"fontes":[],"formula":"E[R] = (1 + D/P − ΔS + i + g + ΔPE) × (1 + φ) − 1, com ΔPE = ln(PE_12 ÷ PE_0)","id":"etf.td2","premissas":null,"resultado":0.0744552,"resultado_texto":"7,45%","substituicao":"E[R] = (1 + 5,10% − 4,82% + 3,23% + 2,00% + 1,94%) × (1 + 0,00%) − 1 = 7,45%","titulo":"Top-down 2: Grinold–Kroner","unidade":"%"},{"fontes":[],"formula":"R_TD = média(TD1, TD2 disponíveis)","id":"etf.td","premissas":null,"resultado":0.12132,"resultado_texto":"12,13%","substituicao":"R_TD = média(16,82%; 7,45%) = 12,13%","titulo":"Top-down combinado","unidade":"%"},{"fontes":[],"formula":"R_BU = Σ w_i × [(1 + u_i)(1 + φ_i) − 1 + y_i(1 + φ_i)] + c × r_caixa − TER","id":"etf.bu","premissas":"peso coberto por alvos citáveis da casa (confiança A ou B, sem aviso de retorno extremo ou patrimônio frágil) 81,39%; as demais posições recebem o retorno top-down","resultado":0.171196,"resultado_texto":"17,12%","substituicao":"R_BU = Σ das 76 posições + 0,00% × 13,75% − 0,10% = 17,12%","titulo":"Bottom-up (alvos da casa por posição)","unidade":"%"},{"fontes":[],"formula":"R_e = ω × R_BU + (1 − ω) × R_TD; ω = 0,5 × mín(1; cobertura ÷ 0,90)","id":"etf.combinado","premissas":null,"resultado":0.143872,"resultado_texto":"14,39%","substituicao":"R_e = 0,452 × 17,12% + 0,548 × 12,13% = 14,39%","titul